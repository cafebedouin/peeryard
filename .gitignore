# evidence of runs stays local (a reviewer may be asked follow-up questions about it); only the layout is tracked
audits/*
!audits/README.md
!audits/EXAMPLE_pr-review/
__pycache__/

# a private issue register never travels with peeryard
ISSUES.md
issues.json

# rendered review-queue pages (queue/build.py output; deployed by the workflow, never committed)
site/

# stray outputs at the root: ci/release-check/scope.py writes scope.{json,md} to the working directory by default
# (the workflow passes --out), and an empty ergo.log was once committed by accident
/scope.json
/scope.md
/ergo.log
