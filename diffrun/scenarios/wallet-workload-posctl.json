{
  "name": "wallet-workload-posctl",
  "description": "The wallet workload's positive control (preset posctl): a token issue and a burn, judged with an extra invariant that asserts the burned amount is still held, which must FAIL (control_tripped); a run where it holds, or where a real invariant fails, does not count as a tripped control.",
  "script": "wallet-workload.sh",
  "tier": "public",
  "mixed_jars": true,
  "env": {
    "WW_PRESET": "posctl",
    "WW_SCENARIO": "wallet-workload-posctl"
  },
  "metrics": {
    "pass": "boolean",
    "control_tripped": "boolean",
    "steps": "number",
    "steps_pass": "number",
    "steps_fail": "number",
    "conflict_runs": "number",
    "conflict_two_in_flight": "number",
    "resubmit_runs": "number",
    "resubmit_two_accepted": "number",
    "unresponsive_after": "number"
  },
  "n": 1,
  "min_valid_runs": 1,
  "timeout_seconds": 1200,
  "expect": {
    "base": {
      "all": {
        "key": "control_tripped",
        "op": "==",
        "value": true
      }
    },
    "candidate": {
      "all": {
        "key": "control_tripped",
        "op": "==",
        "value": true
      }
    }
  }
}
