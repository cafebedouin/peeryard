@@ -210,7 +210,10 @@ class ErgoNodeViewSynchronizer(networkControllerRef: ActorRef,
 
     // Per-peer budget is charged with a floor for declined transactions, see `MinDeclinedTxCost`. The global
     // counter below keeps the measured costs only.
+    // A decline by this node's own policy (its fee floor) is charged at its measured cost: the peer forwarded a
+    // transaction another node accepts, and the floor is for declines whose cheapness a peer can manufacture.
     val chargedCost = processingResult match {
+      case d: DeclinedTransaction if d.policy => cost
       case _: DeclinedTransaction => math.max(cost, MinDeclinedTxCost)
       case _ => cost
     }
@@ -1483,7 +1486,7 @@ class ErgoNodeViewSynchronizer(networkControllerRef: ActorRef,
       processMempoolResult(st)
       broadcastModifierInv(tx)
 
-    case dt@DeclinedTransaction(utx: UnconfirmedTransaction) =>
+    case dt@DeclinedTransaction(utx: UnconfirmedTransaction, _) =>
       addDeclined(utx.id)
       processMempoolResult(dt)
 
