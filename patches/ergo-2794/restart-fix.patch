diff --git a/src/main/scala/org/ergoplatform/nodeView/history/ErgoHistory.scala b/src/main/scala/org/ergoplatform/nodeView/history/ErgoHistory.scala
index acd9b83a0..7d1ea3b64 100644
--- a/src/main/scala/org/ergoplatform/nodeView/history/ErgoHistory.scala
+++ b/src/main/scala/org/ergoplatform/nodeView/history/ErgoHistory.scala
@@ -579,6 +579,18 @@ object ErgoHistory extends ScorexLogging {
       }
     })(history.closeStorage())
 
+    // Pruning starts where the last prune stopped (FullBlockProcessor). A node that prunes and has full blocks but no
+    // such record (its first start with this version) gets it from its stored floor here, before the first fresh
+    // header after the start can move the floor. A node without full blocks gets it at its first prune, so the first
+    // range after a UTXO-snapshot or NiPoPoW bootstrap does not start at genesis.
+    stopOnFailure("Pruned height record", Try {
+      if (nodeSettings.isFullBlocksPruned && history.bestFullBlockOpt.isDefined && history.readPrunedBelowHeight().isEmpty) {
+        val floor = history.readMinimalFullBlockHeight()
+        history.writePrunedBelowHeight(floor).get
+        log.info(s"Full blocks below height $floor are taken as pruned")
+      }
+    })(history.closeStorage())
+
     log.info("History database read")
     history
   }
diff --git a/src/main/scala/org/ergoplatform/nodeView/history/storage/modifierprocessors/FullBlockProcessor.scala b/src/main/scala/org/ergoplatform/nodeView/history/storage/modifierprocessors/FullBlockProcessor.scala
index e62f9a420..9c5dd1d0e 100644
--- a/src/main/scala/org/ergoplatform/nodeView/history/storage/modifierprocessors/FullBlockProcessor.scala
+++ b/src/main/scala/org/ergoplatform/nodeView/history/storage/modifierprocessors/FullBlockProcessor.scala
@@ -106,11 +106,24 @@ trait FullBlockProcessor extends HeadersProcessor {
         if (nonBestChainsCache.nonEmpty) nonBestChainsCache = nonBestChainsCache.dropUntil(minForkRootHeight)
 
         if (nodeSettings.isFullBlocksPruned) {
-          val prevMinHeight = minimalFullBlockHeight
+          // Start where the last prune stopped, not at the floor before this step: the floor also moves without a
+          // prune (after a restart the first fresh header sets it again), and a prune can fail after it moved.
+          val pruneFrom = readPrunedBelowHeight().getOrElse {
+            val floor = minimalFullBlockHeight
+            writePrunedBelowHeight(floor).failed.foreach(e => log.warn(s"Pruned height record not written: ${e.getMessage}"))
+            floor
+          }
           // Use the received block, not the new best one: from the new best block,
           // a step that fills a gap could prune blocks the state has not applied yet.
           val newMinHeight = updateBestFullBlock(fullBlock.header)
-          pruneBlockDataAt(prevMinHeight until newMinHeight)
+          if (pruneFrom < newMinHeight) {
+            pruneBlockDataAt(pruneFrom until newMinHeight)
+              .flatMap(_ => writePrunedBelowHeight(newMinHeight))
+              .failed.foreach { e =>
+                log.warn(s"Pruning full blocks at heights $pruneFrom until $newMinHeight failed, " +
+                  s"to be retried with the next block: ${e.getMessage}")
+              }
+          }
         }
         ProgressInfo(branchPoint, toRemove, toApply, Seq.empty)
       }
