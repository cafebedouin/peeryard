+              .failed.foreach { e =>
+                log.warn(s"Pruning full blocks at heights $pruneFrom until $newMinHeight failed, " +
+                  s"to be retried with the next block: ${e.getMessage}")
+              }
+          }
         }
         ProgressInfo(branchPoint, toRemove, toApply, Seq.empty)
       }
