@@ -0,0 +1,43 @@
+package scorex.db
+
+import java.io.File
+import java.nio.file.Files
+import java.util.concurrent.{CyclicBarrier, Executors, TimeUnit}
+
+import org.iq80.leveldb.Options
+import org.scalatest.matchers.should.Matchers
+import org.scalatest.propspec.AnyPropSpec
+
+import scala.util.Try
+
+// Throwaway probe (not for any PR): two threads close one registered native DB at the same moment.
+class ConcurrentCloseProbeSpec extends AnyPropSpec with Matchers {
+
+  property("RDBPROBE: two threads close one registered DB at once") {
+    val n = 2000
+    val pool = Executors.newFixedThreadPool(2)
+    val root = Files.createTempDirectory("rdbprobe").toFile
+    println(s"RDBPROBE factory=${LDBFactory.factory} n=$n")
+    var closeErrors = 0
+    var i = 0
+    while (i < n) {
+      val dir = new File(root, s"db$i")
+      dir.mkdirs()
+      val opts = new Options()
+      opts.createIfMissing(true)
+      val a = LDBFactory.factory.open(dir, opts)
+      val b = LDBFactory.factory.open(dir, opts)
+      (a eq b) shouldBe true // the registry hands both openers the same RegisteredDB
+      a.put(Array[Byte](1), Array[Byte](2))
+      val barrier = new CyclicBarrier(2)
+      val f1 = pool.submit(new Runnable { def run(): Unit = { barrier.await(); a.close() } })
+      val f2 = pool.submit(new Runnable { def run(): Unit = { barrier.await(); b.close() } })
+      if (Try(f1.get(30, TimeUnit.SECONDS)).isFailure) closeErrors += 1
+      if (Try(f2.get(30, TimeUnit.SECONDS)).isFailure) closeErrors += 1
+      if (i % 250 == 0) println(s"RDBPROBE iter=$i")
+      i += 1
+    }
+    println(s"RDBPROBE done n=$n closeErrors=$closeErrors")
+    pool.shutdown()
+  }
+}
