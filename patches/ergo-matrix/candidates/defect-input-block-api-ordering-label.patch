+  it should "report the best full block as the ordering block of input blocks" in {
+    // a history whose headers chain is one header ahead of its full blocks
+    val h = applyChain(generateHistory(), genChain(3))
+    val bestFullBlockId = h.bestFullBlockIdOpt.value
+    val nextHeader = genChain(1, h).last.header
+    nextHeader.parentId shouldBe bestFullBlockId
+    h.append(nextHeader).get
+    h.bestHeaderOpt.map(_.id) shouldBe Some(nextHeader.id)
+    h.bestFullBlockIdOpt shouldBe Some(bestFullBlockId)
