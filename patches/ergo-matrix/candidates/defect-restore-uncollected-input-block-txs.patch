+  /**
+    * Selects transactions of input blocks built on the previous best full block which are to be returned to the
+    * mempool once a new best full block is applied. Such transactions were removed from the mempool when their input
+    * blocks were applied. A transaction is returned unless it is included into the applied blocks, spends a box
+    * spent by an applied transaction, or spends an output of an input-block transaction which is not returned.
+    * Other validity checks are left to the regular mempool re-check, as for transactions of rolled back blocks.
+    *
+    * @param inputBlockTxs - transactions of the best input-blocks chain built on the previous best full block,
+    *                        in chain order
+    * @param appliedTxs    - transactions of the applied full blocks
+    * @return transactions to return to the mempool, in chain order
+    */
+  def uncollectedInputBlockTransactions(inputBlockTxs: Seq[ErgoTransaction],
+                                        appliedTxs: Seq[ErgoTransaction]): Seq[ErgoTransaction] = {
+    val appliedIds = appliedTxs.map(_.id).toSet
+    val spentByApplied: Set[ModifierId] = appliedTxs.flatMap(_.inputs.map(i => bytesToId(i.boxId))).toSet
+    val init = (Vector.empty[ErgoTransaction], Set.empty[ModifierId]) // (returned txs, outputs not available)
+    val (toReturn, _) = inputBlockTxs.foldLeft(init) { case ((acc, unavailable), tx) =>
+      if (appliedIds.contains(tx.id)) {
+        (acc, unavailable)
+      } else if (tx.inputs.exists { i =>
+          val boxId = bytesToId(i.boxId)
+          spentByApplied.contains(boxId) || unavailable.contains(boxId)
+        }) {
+        (acc, unavailable ++ tx.outputs.map(o => bytesToId(o.id)))
+      } else {
+        (acc :+ tx, unavailable)
+      }
+    }
+    toReturn
+  }
