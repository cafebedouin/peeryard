index 000000000..62a197ea6
--- /dev/null
+++ b/src/test/scala/org/ergoplatform/nodeView/history/modifierprocessors/InputBlockProcessorConcurrencySpecification.scala
@@ -0,0 +1,94 @@
+package org.ergoplatform.nodeView.history.modifierprocessors
+
+import com.google.common.io.Files.createTempDir
+import org.ergoplatform.ErgoBox
+import org.ergoplatform.mining.InputBlockFields
+import org.ergoplatform.nodeView.state.{BoxHolder, StateType, UtxoState}
+import org.ergoplatform.settings.Algos
+import org.ergoplatform.subblocks.InputBlockAnnouncement
+import org.ergoplatform.utils.ErgoCorePropertyTest
+import org.ergoplatform.utils.ErgoCoreTestConstants.parameters
+import org.ergoplatform.utils.HistoryTestHelpers.generateHistory
+import org.ergoplatform.utils.generators.ChainGenerator.{applyChain, genChain}
+import scorex.crypto.authds.merkle.BatchMerkleProof
+import scorex.crypto.hash.Digest32
+import scorex.util.bytesToId
+import sigma.Colls
+import sigma.ast.ErgoTree
+import sigma.data.TrivialProp.TrueProp
+
+import java.util.concurrent.atomic.{AtomicBoolean, AtomicLong, AtomicReference}
+
+/**
+  * The node view holder applies input blocks to the history while the synchronizer reads the same history from its
+  * own thread (e.g. `getInputBlock` on `NewBestInputBlock`). An input block already stored must stay visible to a
+  * reader while other input blocks are being applied.
+  */
+class InputBlockProcessorConcurrencySpecification extends ErgoCorePropertyTest {
+
+  import org.ergoplatform.utils.ErgoNodeTestConstants._
+
+  private val box = new ErgoBox(
+    value = 1000000000L,
+    ergoTree = ErgoTree.fromProposition(TrueProp),
+    creationHeight = 0,
+    additionalTokens = Colls.emptyColl,
+    additionalRegisters = Map.empty,
+    transactionId = bytesToId(Algos.hash("concurrencyTx")),
+    index = 0
+  )
+
+  // a previous input block this history does not know: the announcement goes to the disconnected waitlist
+  private def unknownPrev(i: Int): InputBlockFields = {
+    new InputBlockFields(
+      Some(Algos.hash(s"unknown-prev-$i")),
+      Digest32 @@ Array.fill(32)(0.toByte),
+      Digest32 @@ Array.fill(32)(0.toByte),
+      BatchMerkleProof(Seq.empty, Seq.empty)(Algos.hash))
+  }
+
+  property("a stored input block stays visible to a reader while other input blocks are applied") {
+    val us = UtxoState.fromBoxHolder(BoxHolder(Seq(box)), None, createTempDir, settings, parameters)
+    val h = generateHistory(verifyTransactions = true, StateType.Utxo, PoPoWBootstrap = false, blocksToKeep = -1,
+      epochLength = 10000, useLastEpochs = 3, initialDiffOpt = None, None)
+    applyChain(h, genChain(2, h, stateOpt = Some(us)))
+    val template = genChain(2, h, stateOpt = Some(us)).tail.head.header
+
+    val target = InputBlockAnnouncement(1, template, InputBlockFields.empty, None)
+    h.applyInputBlock(target)
+    h.getInputBlock(target.id) shouldBe Some(target)
+
+    val others = (1 to 20000).map { i =>
+      InputBlockAnnouncement(1, template.copy(timestamp = template.timestamp + i), unknownPrev(i), None)
+    }
+
+    val writing = new AtomicBoolean(true)
+    val misses = new AtomicLong(0)
+    val reads = new AtomicLong(0)
+    val readerError = new AtomicReference[Throwable](null)
+    val reader = new Thread(() => {
+      try {
+        while (writing.get()) {
+          reads.incrementAndGet()
+          if (h.getInputBlock(target.id).isEmpty) misses.incrementAndGet()
+        }
+      } catch {
+        case t: Throwable => readerError.set(t)
+      }
+    })
+    reader.start()
+    try {
+      others.foreach(h.applyInputBlock)
+    } finally {
+      writing.set(false)
+      reader.join()
+    }
+
+    Option(readerError.get()) shouldBe None
+    h.getInputBlock(target.id) shouldBe Some(target)
+    reads.get() should be > 0L
+    withClue(s"${misses.get()} of ${reads.get()} concurrent reads missed the stored input block: ") {
+      misses.get() shouldBe 0L
+    }
+  }
+}
diff --git a/src/test/scala/org/ergoplatform/nodeView/history/modifierprocessors/InputBlocksTreeBehaviourSpecification.scala b/src/test/scala/org/ergoplatform/nodeView/history/modifierprocessors/InputBlocksTreeBehaviourSpecification.scala
new file mode 100644
index 000000000..988e79c5b
--- /dev/null
+++ b/src/test/scala/org/ergoplatform/nodeView/history/modifierprocessors/InputBlocksTreeBehaviourSpecification.scala
@@ -0,0 +1,142 @@
+package org.ergoplatform.nodeView.history.modifierprocessors
+
+import com.google.common.io.Files.createTempDir
+import org.ergoplatform.ErgoBox
+import org.ergoplatform.mining.InputBlockFields
+import org.ergoplatform.modifiers.history.header.Header
+import org.ergoplatform.nodeView.history.ErgoHistory
+import org.ergoplatform.nodeView.state.{BoxHolder, StateType, UtxoState}
+import org.ergoplatform.settings.Algos
+import org.ergoplatform.subblocks.InputBlockAnnouncement
+import org.ergoplatform.utils.ErgoCorePropertyTest
+import org.ergoplatform.utils.ErgoCoreTestConstants.parameters
+import org.ergoplatform.utils.HistoryTestHelpers.generateHistory
+import org.ergoplatform.utils.generators.ChainGenerator.{applyChain, genChain}
+import scorex.crypto.authds.merkle.BatchMerkleProof
+import scorex.crypto.hash.Digest32
+import scorex.util.{bytesToId, idToBytes}
+import sigma.Colls
+import sigma.ast.ErgoTree
+import sigma.data.TrivialProp.TrueProp
+
+/**
+  * Behaviour of the input-blocks tree (best tip, sibling forks, fork switch) observed through the history API.
+  */
+class InputBlocksTreeBehaviourSpecification extends ErgoCorePropertyTest {
+
+  import org.ergoplatform.utils.ErgoNodeTestConstants._
+
+  private def box(seed: String, index: Short): ErgoBox = new ErgoBox(
+    value = 1000000000L,
+    ergoTree = ErgoTree.fromProposition(TrueProp),
+    creationHeight = 0,
+    additionalTokens = Colls.emptyColl,
+    additionalRegisters = Map.empty,
+    transactionId = bytesToId(Algos.hash(seed)),
+    index = index
+  )
+
+  private def parentOnly(parentId: Array[Byte]): InputBlockFields = {
+    new InputBlockFields(
+      Some(parentId),
+      Digest32 @@ Array.fill(32)(0.toByte),
+      Digest32 @@ Array.fill(32)(0.toByte),
+      BatchMerkleProof(Seq.empty, Seq.empty)(Algos.hash))
+  }
+
+  private def withHistory(test: (UtxoState, ErgoHistory, Header) => Unit): Unit = {
+    val us = UtxoState.fromBoxHolder(BoxHolder(Seq(box("a", 0), box("b", 1))), None, createTempDir(), settings, parameters)
+    val h = generateHistory(verifyTransactions = true, StateType.Utxo, PoPoWBootstrap = false, blocksToKeep = -1,
+      epochLength = 10000, useLastEpochs = 3, initialDiffOpt = None, None)
+    try {
+      val orderingChain = genChain(height = 2, history = h, stateOpt = Some(us)).toList
+      applyChain(h, orderingChain)
+      h.bestFullBlockOpt.get.id shouldBe orderingChain.last.id
+      test(us, h, h.bestHeaderOpt.get)
+    } finally {
+      try h.closeStorage()
+      finally us.closeStorage()
+    }
+  }
+
+  // header of an input block on top of the given ordering block
+  private def inputHeader(h: ErgoHistory, us: UtxoState, orderingParent: Header): Header = {
+    val header = genChain(2, h, stateOpt = Some(us)).tail.head.header
+    header.parentId shouldBe orderingParent.id
+    header
+  }
+
+  private def root(h: ErgoHistory, us: UtxoState, p: Header): InputBlockAnnouncement =
+    InputBlockAnnouncement(1, inputHeader(h, us, p), InputBlockFields.empty, None)
+
+  private def child(h: ErgoHistory, us: UtxoState, p: Header, parent: InputBlockAnnouncement): InputBlockAnnouncement =
+    InputBlockAnnouncement(1, inputHeader(h, us, p), parentOnly(idToBytes(parent.id)), None)
+
+  property("best input block is the tip of the processed best chain, not a known but unprocessed child") {
+    withHistory { (us, h, p) =>
+      val a = root(h, us, p)
+      h.applyInputBlock(a) shouldBe None
+      h.applyInputBlockTransactions(a.id, Seq.empty, us) shouldBe (Seq(a.id) -> Seq.empty)
+      h.bestInputBlock().map(_.id) shouldBe Some(a.id)
+
+      // b is announced on top of a, its transactions are not received yet
+      val b = child(h, us, p, a)
+      h.applyInputBlock(b) shouldBe None
+      h.bestInputBlocksChain() shouldBe Seq(a.id)
+
+      // the best input block (used by the candidate generator as the parent of the next input block, while it
+      // collects the transactions of bestInputBlocksChain) must be the tip of that chain
+      h.bestInputBlock().map(_.id) shouldBe h.bestInputBlocksChain().headOption
+    }
+  }
+
+  property("processing a block both sibling forks wait for keeps the best fork's progress") {
+    withHistory { (us, h, p) =>
+      val a = root(h, us, p)
+      h.applyInputBlock(a) shouldBe None
+      h.applyInputBlockTransactions(a.id, Seq.empty, us) shouldBe (Seq(a.id) -> Seq.empty)
+
+      // a <- b <- c and a <- b <- d: two forks, both waiting for b
+      val b = child(h, us, p, a)
+      val c = child(h, us, p, b)
+      val d = child(h, us, p, b)
+      h.applyInputBlock(b) shouldBe None
+      h.applyInputBlock(c) shouldBe None
+      h.applyInputBlock(d) shouldBe None
+      h.inputBlocksTree().get.forks.map(f => f.chain -> f.processedIndex) shouldBe Seq(
+        Seq(a.id, b.id, c.id) -> 0,
+        Seq(a.id, b.id, d.id) -> 0
+      )
+
+      // c's transactions arrive before b's
+      h.applyInputBlockTransactions(c.id, Seq.empty, us) shouldBe (Seq.empty -> Seq.empty)
+
+      // b's transactions: b and then c are processed on the best fork, and reported as applied
+      h.applyInputBlockTransactions(b.id, Seq.empty, us) shouldBe (Seq(b.id, c.id) -> Seq.empty)
+
+      // the tree keeps what was reported
+      h.bestInputBlocksChain() shouldBe Seq(c.id, b.id, a.id)
+    }
+  }
+
+  property("switching to a fork with no common input block rolls back the abandoned processed blocks") {
+    withHistory { (us, h, p) =>
+      val ib1 = root(h, us, p)
+      h.applyInputBlock(ib1) shouldBe None
+      h.applyInputBlockTransactions(ib1.id, Seq.empty, us) shouldBe (Seq(ib1.id) -> Seq.empty)
+      h.bestInputBlocksChain() shouldBe Seq(ib1.id)
+
+      // a competing fork ib2 <- ib3, sharing no input block with ib1
+      val ib2 = root(h, us, p)
+      val ib3 = child(h, us, p, ib2)
+      h.applyInputBlock(ib2) shouldBe None
+      h.applyInputBlock(ib3) shouldBe None
+      h.applyInputBlockTransactions(ib2.id, Seq.empty, us) shouldBe (Seq.empty -> Seq.empty)
+
+      // the longer fork wins; ib1 was processed and is abandoned, so it is reported as rolled back
+      h.applyInputBlockTransactions(ib3.id, Seq.empty, us) shouldBe (Seq(ib2.id, ib3.id) -> Seq(ib1.id))
+      h.bestInputBlocksChain() shouldBe Seq(ib3.id, ib2.id)
+    }
+  }
+
+}
