+++ b/src/test/scala/org/ergoplatform/nodeView/viewholder/OrderingBlockRebuildFromInputBlocksSpec.scala
@@ -0,0 +1,161 @@
+package org.ergoplatform.nodeView.viewholder
+
+import scala.concurrent.duration._
+import org.ergoplatform.OrderingBlockFound
+import org.ergoplatform.mining.InputBlockFields
+import org.ergoplatform.modifiers.ErgoFullBlock
+import org.ergoplatform.modifiers.history.extension.{Extension, ExtensionCandidate}
+import org.ergoplatform.modifiers.history.header.Header
+import org.ergoplatform.modifiers.mempool.ErgoTransaction
+import org.ergoplatform.network.ErgoNodeViewSynchronizerMessages._
+import org.ergoplatform.network.message.inputblocks.{InputBlockTransactionsData, OrderingBlockAnnouncement}
+import org.ergoplatform.nodeView.state.{ErgoState, StateType, UtxoState}
+import org.ergoplatform.nodeView.state.StateType.Utxo
+import org.ergoplatform.nodeView.state.wrapped.WrappedUtxoState
+import org.ergoplatform.settings.{ErgoValidationSettingsUpdate, Parameters}
+import org.ergoplatform.settings.Constants.TrueTree
+import org.ergoplatform.subblocks.InputBlockAnnouncement
+import org.ergoplatform.utils.{ErgoCorePropertyTest, NodeViewTestConfig, NodeViewTestOps, TestCase}
+import org.ergoplatform.utils.fixtures.NodeViewFixture
+import org.ergoplatform.wallet.utils.FileUtils
+import scorex.core.network.ConnectedPeer
+import scorex.util.{ModifierId, idToBytes}
+
+/**
+  * A node that has processed the input blocks of an ordering block's parent rebuilds the ordering block from them and
+  * the announced ordering-only transactions, without downloading the block transactions.
+  *
+  * The announcement carries only the transactions the miner added on top of the collected input-block transactions
+  * (the synchronizer sends the ordering-only list); the block holds the collected input-block transactions first,
+  * then the ordering-only ones (CandidateGenerator: previousOrderingBlockTransactions ++ orderingTxs). As a miner's
+  * block does, its extension names the input block it builds on (PrevInputBlockIdKey).
+  */
+class OrderingBlockRebuildFromInputBlocksSpec extends ErgoCorePropertyTest with NodeViewTestOps with FileUtils {
+  import org.ergoplatform.utils.ErgoCoreTestConstants._
+  import org.ergoplatform.utils.generators.ErgoNodeTransactionGenerators._
+  import org.ergoplatform.utils.generators.ValidBlocksGenerators._
+
+  private val Rebuilt = "rebuilt from input blocks"
+  private val NotRebuilt = "not rebuilt: best full block unchanged"
+
+  /**
+    * Applies genesis, processes an input block on top of it carrying `inputBlockTxs(genesis)`, then announces an
+    * ordering block on top of genesis whose transactions are the input-block ones followed by `orderingTxs`.
+    * @return how the node obtained the ordering block transactions
+    */
+  private def announceAfterInputBlock(fixture: NodeViewFixture)
+                                     (inputBlockTxs: ErgoFullBlock => Seq[ErgoTransaction],
+                                      orderingTxs: Seq[ErgoTransaction] => Seq[ErgoTransaction]): String = {
+    import fixture._
+    val (us, bh) = createUtxoState(fixture.settings)
+    val genesis = validFullBlock(parentOpt = None, us, bh)
+    applyBlock(genesis) shouldBe 'success
+
+    val ibTxs = inputBlockTxs(genesis)
+    val ownTxs = orderingTxs(ibTxs)
+
+    // an input block built on genesis carries ibTxs
+    val (_, bh2) = createUtxoState(fixture.settings)
+    val siblingBlock = validFullBlock(Some(genesis), WrappedUtxoState(us, bh2, fixture.settings))
+    val inputBlock = InputBlockAnnouncement(1, siblingBlock.header, InputBlockFields.empty, None)
+    val dummyPeer = ConnectedPeer(
+      scorex.core.network.ConnectionId(
+        new java.net.InetSocketAddress("127.0.0.1", 1234),
+        new java.net.InetSocketAddress("127.0.0.1", 5678),
+        scorex.core.network.Outgoing
+      ),
+      testProbe.ref,
+      None
+    )
+
+    subscribeEvents(classOf[NewBestInputBlock])
+    nodeViewHolderRef ! ProcessInputBlock(inputBlock, dummyPeer)
+    nodeViewHolderRef ! ProcessInputBlockTransactions(InputBlockTransactionsData(inputBlock.id, ibTxs))
+    testProbe.fishForMessage(5.seconds) {
+      case NewBestInputBlock(idOpt, _) => idOpt.contains(inputBlock.id)
+      case _ => false
+    }
+    unsubscribeEvents(classOf[NewBestInputBlock])
+    // the input block is processed and its transactions are collected for its ordering parent, genesis
+    getHistory.getCollectedInputBlocksTransactions(genesis.id).map(_.map(_.id)) shouldBe Some(ibTxs.map(_.id))
+
+    // the next ordering block, as a miner forms it: collected input-block transactions, then its own ones
+    val wusAfterGenesis = WrappedUtxoState(us, bh, fixture.settings).applyModifier(genesis)(_ => ()).get
+    val orderingBlock = orderingBlockNamingInputBlock(genesis, wusAfterGenesis, ibTxs ++ ownTxs, inputBlock.id)
+    val oba = OrderingBlockAnnouncement(
+      version = OrderingBlockAnnouncement.CurrentVersion,
+      header = orderingBlock.header,
+      nonBroadcastedTransactions = ownTxs,
+      broadcastedTransactionIds = Seq.empty,
+      extensionFields = orderingBlock.extension.fields
+    )
+
+    nodeViewHolderRef ! ProcessOrderingBlock(oba)
+
+    // no peer answers download requests here, so the block becomes the best full block only if the node rebuilt its
+    // transactions from the collected input blocks and the announcement
+    val deadline = System.currentTimeMillis() + 10000
+    while (!getBestFullBlockOpt.map(_.id).contains(orderingBlock.id) && System.currentTimeMillis() < deadline) {
+      Thread.sleep(100)
+    }
+    val outcome = if (getBestFullBlockOpt.map(_.id).contains(orderingBlock.id)) Rebuilt else NotRebuilt
+    outcome
+  }
+
+  /**
+    * An ordering block on `parent` holding `transactions`: the block ValidBlocksGenerators.validFullBlock builds, proved
+    * again with one more extension field, PrevInputBlockIdKey -> `prevInputBlockId`, as CandidateBlock writes it for a
+    * miner that has an input block on top of the parent.
+    */
+  private def orderingBlockNamingInputBlock(parent: ErgoFullBlock,
+                                            utxoState: UtxoState,
+                                            transactions: Seq[ErgoTransaction],
+                                            prevInputBlockId: ModifierId): ErgoFullBlock = {
+    val plain = validFullBlock(Some(parent), utxoState, transactions)
+    val extension: ExtensionCandidate = ExtensionCandidate(plain.extension.fields) ++
+      ExtensionCandidate(Seq(Extension.PrevInputBlockIdKey -> idToBytes(prevInputBlockId)))
+    val defaultParams = Parameters(0, Parameters.DefaultParameters, ErgoValidationSettingsUpdate.empty)
+    powScheme.proveBlock(Some(parent.header), Header.InitialVersion, chainSettings.initialNBits, plain.header.stateRoot,
+      plain.adProofs.get.proofBytes, transactions, plain.header.timestamp, extension, Array.fill(3)(0: Byte),
+      defaultMinerSecretNumber, Long.MinValue, Long.MaxValue, defaultParams).asInstanceOf[OrderingBlockFound].fb
+  }
+
+  private def genesisBoxes(genesis: ErgoFullBlock) = {
+    val boxes = ErgoState.newBoxes(genesis.transactions).find(_.ergoTree == TrueTree).toIndexedSeq
+    boxes.nonEmpty shouldBe true
+    boxes
+  }
+
+  private val onlyInputBlockTxs = TestCase("ordering block holding only input-block transactions is rebuilt") { fixture =>
+    import fixture._
+    if (stateType == Utxo && verifyTransactions) {
+      val outcome = announceAfterInputBlock(fixture)(
+        genesis => Seq(validTransactionFromBoxes(genesisBoxes(genesis), issueNew = false)),
+        _ => Seq.empty
+      )
+      outcome shouldBe Rebuilt
+    }
+  }
+
+  private val inputAndOrderingTxs = TestCase("ordering block holding input-block and ordering-only transactions is rebuilt") { fixture =>
+    import fixture._
+    if (stateType == Utxo && verifyTransactions) {
+      val outcome = announceAfterInputBlock(fixture)(
+        genesis => Seq(validTransactionFromBoxes(genesisBoxes(genesis), issueNew = false)),
+        // the miner's own transaction spends an output of the input-block transaction
+        ibTxs => Seq(validTransactionFromBoxes(IndexedSeq(ibTxs.head.outputs.head), issueNew = false))
+      )
+      outcome shouldBe Rebuilt
+    }
+  }
+
+  val cases: List[TestCase] = List(onlyInputBlockTxs, inputAndOrderingTxs)
+
+  NodeViewTestConfig.verifyTxConfigs.filter(_.stateType == StateType.Utxo).foreach { c =>
+    cases.foreach { t =>
+      property(s"${t.name} - $c") {
+        t.run(parameters, c)
+      }
+    }
+  }
+}
