-  private def withFixture(test: Fixture => Any): Unit = withFixture(new Fixture)(test)
-
-  private def withFixture(f: Fixture)(test: Fixture => Any): Unit =
-    try test(f) finally Await.result(f.system.terminate(), Duration.Inf)
