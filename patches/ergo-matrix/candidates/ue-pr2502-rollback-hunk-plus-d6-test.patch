@@ -0,0 +1,95 @@
+package org.ergoplatform.nodeView.history.modifierprocessors
+
+import com.google.common.io.Files.createTempDir
+import org.ergoplatform.ErgoBox
+import org.ergoplatform.mining.InputBlockFields
+import org.ergoplatform.modifiers.history.header.Header
+import org.ergoplatform.nodeView.history.ErgoHistory
+import org.ergoplatform.nodeView.state.{BoxHolder, StateType, UtxoState}
+import org.ergoplatform.settings.Algos
+import org.ergoplatform.subblocks.InputBlockAnnouncement
+import org.ergoplatform.utils.ErgoCorePropertyTest
+import org.ergoplatform.utils.ErgoCoreTestConstants.parameters
+import org.ergoplatform.utils.HistoryTestHelpers.generateHistory
+import org.ergoplatform.utils.generators.ChainGenerator.{applyChain, genChain}
+import scorex.crypto.authds.merkle.BatchMerkleProof
+import scorex.crypto.hash.Digest32
+import scorex.util.{bytesToId, idToBytes}
+import sigma.Colls
+import sigma.ast.ErgoTree
+import sigma.data.TrivialProp.TrueProp
+
+/**
+  * A switch to a fork sharing no input block reports the abandoned processed blocks as rolled back. Observed through the history API.
+  */
+class DisjointForkSwitchRollbackSpecification extends ErgoCorePropertyTest {
+
+  import org.ergoplatform.utils.ErgoNodeTestConstants._
+
+  private def box(seed: String, index: Short): ErgoBox = new ErgoBox(
+    value = 1000000000L,
+    ergoTree = ErgoTree.fromProposition(TrueProp),
+    creationHeight = 0,
+    additionalTokens = Colls.emptyColl,
+    additionalRegisters = Map.empty,
+    transactionId = bytesToId(Algos.hash(seed)),
+    index = index
+  )
+
+  private def parentOnly(parentId: Array[Byte]): InputBlockFields = {
+    new InputBlockFields(
+      Some(parentId),
+      Digest32 @@ Array.fill(32)(0.toByte),
+      Digest32 @@ Array.fill(32)(0.toByte),
+      BatchMerkleProof(Seq.empty, Seq.empty)(Algos.hash))
+  }
+
+  private def withHistory(test: (UtxoState, ErgoHistory, Header) => Unit): Unit = {
+    val us = UtxoState.fromBoxHolder(BoxHolder(Seq(box("a", 0), box("b", 1))), None, createTempDir(), settings, parameters)
+    val h = generateHistory(verifyTransactions = true, StateType.Utxo, PoPoWBootstrap = false, blocksToKeep = -1,
+      epochLength = 10000, useLastEpochs = 3, initialDiffOpt = None, None)
+    try {
+      val orderingChain = genChain(height = 2, history = h, stateOpt = Some(us)).toList
+      applyChain(h, orderingChain)
+      h.bestFullBlockOpt.get.id shouldBe orderingChain.last.id
+      test(us, h, h.bestHeaderOpt.get)
+    } finally {
+      try h.closeStorage()
+      finally us.closeStorage()
+    }
+  }
+
+  // header of an input block on top of the given ordering block
+  private def inputHeader(h: ErgoHistory, us: UtxoState, orderingParent: Header): Header = {
+    val header = genChain(2, h, stateOpt = Some(us)).tail.head.header
+    header.parentId shouldBe orderingParent.id
+    header
+  }
+
+  private def root(h: ErgoHistory, us: UtxoState, p: Header): InputBlockAnnouncement =
+    InputBlockAnnouncement(1, inputHeader(h, us, p), InputBlockFields.empty, None)
+
+  private def child(h: ErgoHistory, us: UtxoState, p: Header, parent: InputBlockAnnouncement): InputBlockAnnouncement =
+    InputBlockAnnouncement(1, inputHeader(h, us, p), parentOnly(idToBytes(parent.id)), None)
+
+  property("switching to a fork with no common input block rolls back the abandoned processed blocks") {
+    withHistory { (us, h, p) =>
+      val ib1 = root(h, us, p)
+      h.applyInputBlock(ib1) shouldBe None
+      h.applyInputBlockTransactions(ib1.id, Seq.empty, us) shouldBe (Seq(ib1.id) -> Seq.empty)
+      h.bestInputBlocksChain() shouldBe Seq(ib1.id)
+
+      // a competing fork ib2 <- ib3, sharing no input block with ib1
+      val ib2 = root(h, us, p)
+      val ib3 = child(h, us, p, ib2)
+      h.applyInputBlock(ib2) shouldBe None
+      h.applyInputBlock(ib3) shouldBe None
+      h.applyInputBlockTransactions(ib2.id, Seq.empty, us) shouldBe (Seq.empty -> Seq.empty)
+
+      // the longer fork wins; ib1 was processed and is abandoned, so it is reported as rolled back
+      h.applyInputBlockTransactions(ib3.id, Seq.empty, us) shouldBe (Seq(ib2.id, ib3.id) -> Seq(ib1.id))
+      h.bestInputBlocksChain() shouldBe Seq(ib3.id, ib2.id)
+    }
+  }
+
+}
