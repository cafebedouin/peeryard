diff --git a/src/test/scala/org/ergoplatform/nodeView/history/modifierprocessors/DisjointForkSwitchRollbackSpecification.scala b/src/test/scala/org/ergoplatform/nodeView/history/modifierprocessors/DisjointForkSwitchRollbackSpecification.scala
