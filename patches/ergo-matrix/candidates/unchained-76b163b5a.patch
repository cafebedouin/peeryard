diff --git a/src/test/scala/org/ergoplatform/mining/ErgoMiningThreadSpec.scala b/src/test/scala/org/ergoplatform/mining/ErgoMiningThreadSpec.scala
new file mode 100644
index 000000000..4280bece3
--- /dev/null
+++ b/src/test/scala/org/ergoplatform/mining/ErgoMiningThreadSpec.scala
@@ -0,0 +1,219 @@
+package org.ergoplatform.mining
+
+import akka.actor.{ActorRef, ActorSystem}
+import akka.pattern.StatusReply
+import akka.testkit.{TestKit, TestProbe}
+import org.ergoplatform.mining.CandidateGenerator.{Candidate, GenerateCandidate}
+import org.ergoplatform.nodeView.state.StateType
+import org.ergoplatform.nodeView.{ErgoNodeViewRef, ErgoReadersHolderRef}
+import org.ergoplatform.settings.{ErgoSettings, ErgoSettingsReader}
+import org.ergoplatform.utils.ErgoTestHelpers
+import com.google.common.primitives.Longs
+import org.ergoplatform.modifiers.history.header.Header
+import org.ergoplatform.settings.Parameters
+import org.ergoplatform.{AutolykosSolution, InputBlockHeaderFound, InputSolutionFound, NothingFound,
+  OrderingBlockHeaderFound, OrderingSolutionFound, ProveBlockResult, SolutionFound}
+import scorex.crypto.authds.ADDigest
+import scorex.crypto.hash.Digest32
+import org.scalatest.flatspec.AnyFlatSpec
+import org.scalatest.matchers.should.Matchers
+
+import scala.concurrent.duration._
+
+class ErgoMiningThreadSpec extends AnyFlatSpec with Matchers with ErgoTestHelpers {
+  import org.ergoplatform.utils.ErgoCoreTestConstants._
+
+  private val settings: ErgoSettings = {
+    val empty = ErgoSettingsReader.read()
+    empty.copy(
+      nodeSettings = empty.nodeSettings.copy(
+        mining = true,
+        stateType = StateType.Utxo,
+        internalMinerPollingInterval = 1.second,
+        offlineGeneration = true,
+        verifyTransactions = true
+      ),
+      chainSettings = empty.chainSettings.copy(blockInterval = 1.seconds)
+    )
+  }
+
+  it should "not resubmit a rejected solution's nonce for the same candidate" in new TestKit(ActorSystem()) {
+    // a real candidate, from a real generator
+    val viewHolderRef: ActorRef = ErgoNodeViewRef(settings)
+    val readersHolderRef: ActorRef = ErgoReadersHolderRef(viewHolderRef)
+    val realGenerator: ActorRef =
+      CandidateGenerator(defaultMinerSecret.publicImage, readersHolderRef, viewHolderRef, settings)
+    val candidateProbe = TestProbe()
+    realGenerator.tell(GenerateCandidate(Seq.empty, reply = true, forced = false, optPk = None), candidateProbe.ref)
+    val candidate = candidateProbe.expectMsgPF(5.seconds) { case StatusReply.Success(c: Candidate) => c }
+
+    // the miner thread talks to a probe standing in for the generator
+    val generator = TestProbe()
+    // an input-block hit at nonce 5 and an ordering hit at 900, in the first 1000-nonce batch
+    val minerSettings = settings.copy(chainSettings =
+      settings.chainSettings.copy(powScheme = new KindedHitsPowScheme(Seq(5L), Seq(900L))))
+    ErgoMiningThread(minerSettings, generator.ref, defaultMinerSecret.w)
+    generator.fishForMessage(5.seconds) { case _: GenerateCandidate => true; case _ => false } // a subscription may come first
+    generator.reply(StatusReply.Success(candidate))
+
+    def nextSolution(): SolutionFound = generator.fishForMessage(10.seconds) {
+      case _: InputSolutionFound | _: OrderingSolutionFound => true
+      case _ => false // periodic candidate polls
+    }.asInstanceOf[SolutionFound]
+
+    val first = nextSolution()
+    // the generator rejects it (e.g. the candidate it was mined on is no longer the cached one)
+    generator.reply(StatusReply.Error(new Exception("Invalid input block! PoW valid: false"))) // to the solution's ask
+    val second = nextSolution()
+
+    val (n1, n2) = (Longs.fromByteArray(first.as.n), Longs.fromByteArray(second.as.n))
+    n1 shouldBe 5L
+    n2 should not be n1
+    system.terminate()
+  }
+
+  /** Fake PoW with input-block hits and ordering-block hits at fixed nonces. */
+  private class KindedHitsPowScheme(inputHits: Seq[Long], orderingHits: Seq[Long]) extends DefaultFakePowScheme(32, 26) {
+    override def prove(parentOpt: Option[Header], version: Header.Version, nBits: Long, stateRoot: ADDigest,
+                       adProofsRoot: Digest32, transactionsRoot: Digest32, timestamp: Header.Timestamp,
+                       extensionHash: Digest32, votes: Array[Byte], sk: PrivateKey, minNonce: Long, maxNonce: Long,
+                       parameters: Parameters): ProveBlockResult = {
+      val hits = (inputHits.map(_ -> false) ++ orderingHits.map(_ -> true)).filter { case (h, _) => h >= minNonce && h < maxNonce }
+      if (hits.isEmpty) NothingFound
+      else {
+        val (hit, ordering) = hits.minBy(_._1)
+        super.prove(parentOpt, version, nBits, stateRoot, adProofsRoot, transactionsRoot, timestamp, extensionHash,
+          votes, sk, minNonce, maxNonce, parameters) match {
+          case OrderingBlockHeaderFound(h) =>
+            val s = h.powSolution
+            val withNonce = h.copy(powSolution = new AutolykosSolution(s.pk, s.w, Longs.toByteArray(hit), s.d))
+            if (ordering) OrderingBlockHeaderFound(withNonce) else InputBlockHeaderFound(withNonce)
+          case other => other
+        }
+      }
+    }
+  }
+
+  it should "keep searching a candidate for an ordering solution after its input-block solution is accepted" in
+    new TestKit(ActorSystem()) {
+      val viewHolderRef: ActorRef = ErgoNodeViewRef(settings)
+      val readersHolderRef: ActorRef = ErgoReadersHolderRef(viewHolderRef)
+      val realGenerator: ActorRef =
+        CandidateGenerator(defaultMinerSecret.publicImage, readersHolderRef, viewHolderRef, settings)
+      val candidateProbe = TestProbe()
+      realGenerator.tell(GenerateCandidate(Seq.empty, reply = true, forced = false, optPk = None), candidateProbe.ref)
+      val candidate = candidateProbe.expectMsgPF(30.seconds) { case StatusReply.Success(c: Candidate) => c }
+
+      val generator = TestProbe()
+      // input hits at 5 and 300, an ordering hit at 900, all in the first 1000-nonce batch
+      val minerSettings = settings.copy(chainSettings =
+        settings.chainSettings.copy(powScheme = new KindedHitsPowScheme(Seq(5L, 300L), Seq(900L))))
+      ErgoMiningThread(minerSettings, generator.ref, defaultMinerSecret.w)
+      generator.fishForMessage(5.seconds) { case _: GenerateCandidate => true; case _ => false } // a subscription may come first
+      generator.reply(StatusReply.Success(candidate))
+
+      def nextSolution(within: FiniteDuration): SolutionFound = generator.fishForMessage(within) {
+        case _: InputSolutionFound | _: OrderingSolutionFound => true
+        case _ => false // periodic candidate polls, left unanswered: no new candidate arrives
+      }.asInstanceOf[SolutionFound]
+
+      val first = nextSolution(10.seconds)
+      first shouldBe an[InputSolutionFound]
+      Longs.fromByteArray(first.as.n) shouldBe 5L
+      generator.reply(StatusReply.Success(())) // the input block is accepted (reply to the solution's ask)
+      // with no new candidate, the thread must go on to the ordering hit, skipping the second input hit
+      val second = nextSolution(5.seconds)
+      second shouldBe an[OrderingSolutionFound]
+      Longs.fromByteArray(second.as.n) shouldBe 900L
+      system.terminate()
+    }
+
+  it should "send an ordering solution found after an input-block solution without waiting for the input block's reply" in
+    new TestKit(ActorSystem()) {
+      val viewHolderRef: ActorRef = ErgoNodeViewRef(settings)
+      val readersHolderRef: ActorRef = ErgoReadersHolderRef(viewHolderRef)
+      val realGenerator: ActorRef =
+        CandidateGenerator(defaultMinerSecret.publicImage, readersHolderRef, viewHolderRef, settings)
+      val candidateProbe = TestProbe()
+      realGenerator.tell(GenerateCandidate(Seq.empty, reply = true, forced = false, optPk = None), candidateProbe.ref)
+      val candidate = candidateProbe.expectMsgPF(30.seconds) { case StatusReply.Success(c: Candidate) => c }
+
+      val generator = TestProbe()
+      val minerSettings = settings.copy(chainSettings =
+        settings.chainSettings.copy(powScheme = new KindedHitsPowScheme(Seq(5L, 300L), Seq(900L))))
+      ErgoMiningThread(minerSettings, generator.ref, defaultMinerSecret.w)
+      generator.fishForMessage(5.seconds) { case _: GenerateCandidate => true; case _ => false } // a subscription may come first
+      generator.reply(StatusReply.Success(candidate))
+
+      def nextSolution(within: FiniteDuration): SolutionFound = generator.fishForMessage(within) {
+        case _: InputSolutionFound | _: OrderingSolutionFound => true
+        case _ => false
+      }.asInstanceOf[SolutionFound]
+
+      Longs.fromByteArray(nextSolution(10.seconds).as.n) shouldBe 5L
+      // no reply to the input-block solution: the thread must go on to the ordering hit by itself
+      val second = nextSolution(5.seconds)
+      second shouldBe an[OrderingSolutionFound]
+      Longs.fromByteArray(second.as.n) shouldBe 900L
+      system.terminate()
+    }
+
+  it should "ask for a new candidate as soon as a block is applied" in new TestKit(ActorSystem()) {
+    val generator = TestProbe()
+    // a long poll interval, so only the block-applied event can explain a prompt request
+    val slowPoll = settings.copy(nodeSettings = settings.nodeSettings.copy(internalMinerPollingInterval = 1.hour))
+    ErgoMiningThread(slowPoll, generator.ref, defaultMinerSecret.w)
+    generator.fishForMessage(5.seconds) { case _: GenerateCandidate => true; case _ => false } // a subscription may come first // the first scheduled poll, 1 s after start
+    val header = org.ergoplatform.utils.generators.ErgoCoreGenerators.invalidHeaderGen.sample.get
+    system.eventStream.publish(org.ergoplatform.network.ErgoNodeViewSynchronizerMessages.RemoteBlockApplied(header, Seq.empty))
+    generator.expectMsgClass(1.second, classOf[GenerateCandidate])
+    system.terminate()
+  }
+
+  /** Fake PoW that finds nothing and takes `stepMillis` per step. */
+  private class SlowNothingPowScheme(stepMillis: Long) extends DefaultFakePowScheme(32, 26) {
+    override def prove(parentOpt: Option[Header], version: Header.Version, nBits: Long, stateRoot: ADDigest,
+                       adProofsRoot: Digest32, transactionsRoot: Digest32, timestamp: Header.Timestamp,
+                       extensionHash: Digest32, votes: Array[Byte], sk: PrivateKey, minNonce: Long, maxNonce: Long,
+                       parameters: Parameters): ProveBlockResult = {
+      Thread.sleep(stepMillis)
+      NothingFound
+    }
+  }
+
+  it should "run one nonce-search chain however many candidates arrive while mining" in new TestKit(ActorSystem()) {
+    val viewHolderRef: ActorRef = ErgoNodeViewRef(settings)
+    val readersHolderRef: ActorRef = ErgoReadersHolderRef(viewHolderRef)
+    val realGenerator: ActorRef =
+      CandidateGenerator(defaultMinerSecret.publicImage, readersHolderRef, viewHolderRef, settings)
+    val candidateProbe = TestProbe()
+    realGenerator.tell(GenerateCandidate(Seq.empty, reply = true, forced = false, optPk = None), candidateProbe.ref)
+    val candidate = candidateProbe.expectMsgPF(30.seconds) { case StatusReply.Success(c: Candidate) => c }
+
+    val stepMillis = 20L
+    val generator = TestProbe()
+    val minerSettings = settings.copy(chainSettings =
+      settings.chainSettings.copy(powScheme = new SlowNothingPowScheme(stepMillis)))
+    val thread = ErgoMiningThread(minerSettings, generator.ref, defaultMinerSecret.w)
+    generator.fishForMessage(5.seconds) { case _: GenerateCandidate => true; case _ => false }
+    generator.reply(StatusReply.Success(candidate))
+
+    // 20 new candidates (distinct timestamps) while the thread is mining
+    val n = 20
+    (1 to n).foreach { i =>
+      val cb = candidate.candidateBlock.copy(timestamp = candidate.candidateBlock.timestamp + i)
+      thread ! StatusReply.Success(candidate.copy(candidateBlock = cb))
+    }
+    Thread.sleep(stepMillis * (n + 5))
+
+    // with one chain in flight a message waits at most about one step; with n+1 chains it waits about n+1 steps
+    val probe = TestProbe()
+    val start = System.nanoTime()
+    thread.tell(ErgoMiningThread.GetSolvedBlocksCount, probe.ref)
+    probe.expectMsgClass(5.seconds, classOf[ErgoMiningThread.SolvedBlocksCount])
+    val lagMillis = (System.nanoTime() - start) / 1000000
+    info(s"mailbox lag after $n candidates: $lagMillis ms (step $stepMillis ms)")
+    lagMillis should be < (stepMillis * 5)
+    system.terminate()
+  }
+}
diff --git a/src/test/scala/org/ergoplatform/mining/UnchainedReconstructionSpec.scala b/src/test/scala/org/ergoplatform/mining/UnchainedReconstructionSpec.scala
new file mode 100644
index 000000000..62f9fc1d4
--- /dev/null
+++ b/src/test/scala/org/ergoplatform/mining/UnchainedReconstructionSpec.scala
@@ -0,0 +1,200 @@
+package org.ergoplatform.mining
+
+import org.ergoplatform.modifiers.ErgoFullBlock
+import org.ergoplatform.modifiers.history.extension.Extension.{PrevInputBlockIdKey, PreviousInputBlockTransactionsDigestKey}
+import org.ergoplatform.modifiers.mempool.ErgoTransaction
+import org.ergoplatform.nodeView.history.ErgoHistory
+import org.ergoplatform.nodeView.history.modifierprocessors.InputBlocksProcessor
+import org.ergoplatform.nodeView.mempool.ErgoMemPool
+import org.ergoplatform.nodeView.state.{BoxHolder, StateType, UtxoState}
+import org.ergoplatform.settings.{Algos, Constants}
+import org.ergoplatform.subblocks.InputBlockAnnouncement
+import org.ergoplatform.utils.{HistoryTestHelpers, RandomWrapper}
+import org.ergoplatform.utils.generators.ChainGenerator.{applyChain, genHeaderChain}
+import org.ergoplatform.utils.generators.ValidBlocksGenerators.{createUtxoState, validFullBlock, validTransactionsFromBoxHolder}
+import org.ergoplatform.{ErgoBoxCandidate, Input}
+import org.scalatest.flatspec.AnyFlatSpec
+import org.scalatest.matchers.should.Matchers
+import scorex.crypto.authds.LeafData
+
+/**
+  * Unchained input blocks, end to end through the real candidate generator: the ordering candidate's transactions are
+  * the selected set of its parent ++ ordering-only transactions, and a receiver rebuilds them from the parent's
+  * selected set (the chained design looked under the block's own id and used the opposite order, F1/F2).
+  */
+class UnchainedReconstructionSpec extends AnyFlatSpec with Matchers {
+  import org.ergoplatform.utils.ErgoCoreTestConstants._
+  import org.ergoplatform.utils.ErgoNodeTestConstants.settings
+
+  private class Fixture {
+    private val initial = createUtxoState(settings)
+    var state: UtxoState = initial._1
+    var history: ErgoHistory = HistoryTestHelpers.generateHistory(
+      verifyTransactions = true, stateType = StateType.Utxo,
+      PoPoWBootstrap = false, blocksToKeep = 100
+    )
+
+    private def build(parent: Option[ErgoFullBlock], boxes: BoxHolder, seed: Int,
+                      time: Long): (ErgoFullBlock, BoxHolder) = {
+      val (txs, nextBoxes) = validTransactionsFromBoxHolder(boxes, new RandomWrapper(Some(seed)))
+      val block = validFullBlock(parent, state, txs, Some(time))
+      state = state.applyModifier(block, None)(_ => ()).get
+      block -> nextBoxes
+    }
+
+    private val start = System.currentTimeMillis() - 10000
+    private val rootPair = build(None, initial._2, 1, start)
+    private val a2Pair = build(Some(rootPair._1), rootPair._2, 2, start + 1)
+    val a2: ErgoFullBlock = a2Pair._1
+    private val a2OutputIds = a2.blockTransactions.txs.flatMap(_.outputs).map(_.id.toSeq).toSet
+    private val trueBoxes = a2Pair._2.boxes.values.filter { box =>
+      box.ergoTree == Constants.TrueTree && a2OutputIds.contains(box.id.toSeq)
+    }.toSeq.sortBy(b => Algos.encode(b.id))
+
+    def box(i: Int): org.ergoplatform.ErgoBox = trueBoxes(i)
+
+    def spend(i: Int, dataInputs: IndexedSeq[org.ergoplatform.DataInput] = IndexedSeq.empty): ErgoTransaction = {
+      val box = trueBoxes(i)
+      val tx = ErgoTransaction(
+        IndexedSeq(Input(box.id, emptyProverResult)), dataInputs,
+        IndexedSeq(new ErgoBoxCandidate(box.value, Constants.TrueTree, a2.height, box.additionalTokens))
+      )
+      tx.statelessValidity().get
+      tx
+    }
+
+    val trueBoxCount: Int = trueBoxes.size
+    history = applyChain(history, Seq(rootPair._1, a2))
+
+    private val ibHeader = genHeaderChain(1, history, diffBitsOpt = None, useRealTs = false).last
+    ibHeader.parentId shouldBe a2.id
+    private var ibCounter = 0
+
+    /** Announces an input block on a2 and delivers its transactions. */
+    def inputBlock(txs: Seq[ErgoTransaction]): InputBlockAnnouncement = {
+      ibCounter += 1
+      val ib = InputBlockAnnouncement(1, ibHeader.copy(timestamp = ibHeader.timestamp + ibCounter), InputBlockFields.empty, None)
+      history.applyInputBlock(ib)
+      history.applyInputBlockTransactions(ib.id, txs, state)._1 shouldBe Seq(ib.id)
+      ib
+    }
+
+    def candidate(): CandidateGenerator.Candidate = CandidateGenerator.generateCandidate(
+      history, state, ErgoMemPool.empty(settings), defaultMinerSecret.publicImage, Seq.empty, None, settings
+    ).get.get._1
+
+    def reconstruct(c: CandidateGenerator.Candidate): Option[Seq[ErgoTransaction]] = {
+      val header = CandidateGenerator.deriveUnprovenHeader(c.candidateBlock)
+      history.reconstructOrderingBlockTransactions(
+        header.parentId, header.version, header.transactionsRoot, c.candidateBlock.orderingBlockTransactions)
+    }
+
+    def materialize(c: CandidateGenerator.Candidate): ErgoFullBlock = {
+      val block = c.candidateBlock
+      powScheme.proveBlock(
+        block.parentOpt, block.version, block.nBits, block.stateRoot,
+        block.adProofBytes, block.transactions, block.timestamp, block.extension,
+        block.votes, defaultMinerSecretNumber, Long.MinValue, Long.MaxValue, parameters
+      ) match {
+        case org.ergoplatform.OrderingBlockFound(fb) => fb
+        case org.ergoplatform.InputBlockFound(fb)    => fb
+        case _ => throw new RuntimeException("Unexpected result from proveBlock")
+      }
+    }
+
+    def close(): Unit = {
+      history.closeStorage()
+      state.closeStorage()
+    }
+  }
+
+  "Unchained ordering block" should "be rebuilt from the parent's selected set, also by a receiver whose set grew" in {
+    val f = new Fixture
+    try {
+      f.trueBoxCount should be >= 2
+      val tx1 = f.spend(0)
+      val tx2 = f.spend(1)
+
+      f.inputBlock(Seq(tx1))
+      val c1 = f.candidate()
+      val cb1 = c1.candidateBlock
+      cb1.transactions.head.id shouldBe tx1.id
+      cb1.transactions shouldBe Seq(tx1) ++ cb1.orderingBlockTransactions
+      // no link to a previous input block; the extension commits to the collected (selected) transactions
+      cb1.inputBlockFields.prevInputBlockId shouldBe None
+      cb1.extension.fields.exists(_._1.sameElements(PrevInputBlockIdKey)) shouldBe false
+      val collectedDigest = Algos.merkleTreeRoot(Seq(LeafData @@ tx1.serializedId))
+      cb1.extension.fields.find(_._1.sameElements(PreviousInputBlockTransactionsDigestKey)).map(_._2.toSeq) shouldBe
+        Some(collectedDigest.toSeq)
+
+      f.reconstruct(c1).map(_.map(_.id)) shouldBe Some(cb1.transactions.map(_.id))
+
+      // another input block joins after c1 was built: c1's block still rebuilds (selected-set prefix)
+      f.inputBlock(Seq(tx1, tx2)) // tx1 duplicate, tx2 new
+      f.history.getBestOrderingCollectedInputBlocksTransactions().map(_.id) shouldBe Seq(tx1.id, tx2.id)
+      f.reconstruct(c1).map(_.map(_.id)) shouldBe Some(cb1.transactions.map(_.id))
+
+      val c2 = f.candidate()
+      c2.candidateBlock.transactions.take(2).map(_.id) shouldBe Seq(tx1.id, tx2.id)
+      f.reconstruct(c2).map(_.map(_.id)) shouldBe Some(c2.candidateBlock.transactions.map(_.id))
+
+      // the ordering block is a valid full block
+      f.state.applyModifier(f.materialize(c2), None)(_ => ()).isSuccess shouldBe true
+    } finally f.close()
+  }
+
+  "Selection limits" should "leave room for the emission transaction when the selected set fills the block" in {
+    val f = new Fixture
+    try {
+      f.trueBoxCount should be >= 2
+      val state = f.state
+      val params = state.stateContext.currentParameters
+      val pk = defaultMinerSecret.publicImage
+      val emissionTx = CandidateGenerator.collectEmission(state, pk, state.stateContext).get
+      val upcoming = state.stateContext.upcoming(pk.value, f.a2.header.timestamp + 1, f.a2.header.nBits,
+        f.a2.header.votes, org.ergoplatform.settings.ErgoValidationSettingsUpdate.empty, f.a2.header.version)
+
+      // the reserves really cover the emission transaction
+      emissionTx.size should be <= InputBlocksProcessor.EmissionSizeReserve
+      val emissionCost = state.validateWithCost(emissionTx, upcoming, params.maxBlockCost, None, softFieldsAllowed = true).get
+      emissionCost should be <= InputBlocksProcessor.EmissionCostReserve
+
+      // a selected set exactly as large as the selection size limit of a block of size `blockSize`
+      val selected = (0 until f.trueBoxCount).map(i => f.spend(i))
+      val selectedSize = selected.map(_.size).sum
+      val blockSize = selectedSize + InputBlocksProcessor.FramingSizeReserve + InputBlocksProcessor.EmissionSizeReserve
+      val (_, sizeLimit) = InputBlocksProcessor.selectionLimits(params.maxBlockCost, blockSize)
+      sizeLimit shouldBe selectedSize.toLong
+      val costLimit = (params.maxBlockCost - InputBlocksProcessor.orderingCostGap(params.maxBlockCost)).toInt
+
+      val (_, ordering, _) = CandidateGenerator.collectTxs(pk, costLimit, blockSize, state, upcoming,
+        Seq(emissionTx), selected)
+      ordering.map(_.id) should contain(emissionTx.id)
+
+      // control: without the reserve the reward does not fit
+      val (_, orderingTight, _) = CandidateGenerator.collectTxs(pk, costLimit, selectedSize + 64, state, upcoming,
+        Seq(emissionTx), selected)
+      orderingTight.map(_.id) should not contain emissionTx.id
+    } finally f.close()
+  }
+
+  "A full block" should "accept a data input reading a box spent by an earlier tx of the same block, and the reverse" in {
+    // Data inputs are resolved against the pre-block state (state lookups run before removals), so both orders are
+    // valid full blocks on this code; the selection therefore does not treat spend-then-read as a conflict.
+    def check(order: (ErgoTransaction, ErgoTransaction) => Seq[ErgoTransaction]): Unit = {
+      val f = new Fixture
+      try {
+        f.trueBoxCount should be >= 2
+        val spendB = f.spend(0)
+        val readB = f.spend(1, IndexedSeq(org.ergoplatform.DataInput(f.box(0).id)))
+        val block = validFullBlock(Some(f.a2), f.state, order(spendB, readB))
+        val applied = f.state.applyModifier(block, None)(_ => ())
+        applied.failed.foreach(e => fail(s"block rejected: ${e.getMessage}"))
+        f.state = applied.get
+      } finally f.close()
+    }
+    check((spend, read) => Seq(spend, read)) // spend B, then read B
+    check((spend, read) => Seq(read, spend)) // read B, then spend B
+  }
+
+}
diff --git a/src/test/scala/org/ergoplatform/network/ErgoNodeViewSynchronizerSpecification.scala b/src/test/scala/org/ergoplatform/network/ErgoNodeViewSynchronizerSpecification.scala
