+  private val t48 = TestCase("new best ordering block prunes the parent's input-block set and returns uncollected txs to the mempool") { fixture =>
+    import fixture._
+    if (stateType == Utxo && verifyTransactions) {
+      val (us, bh) = createUtxoState(fixture.settings)
+      val genesis = validFullBlock(parentOpt = None, us, bh)
+      applyBlock(genesis) shouldBe 'success
+
+      val wusAfterGenesis = WrappedUtxoState(us, bh, fixture.settings).applyModifier(genesis)(_ => ()).get
+      // a mempool tx on a genesis output; nextBlock is built from the other boxes, so it does not spend it
+      val box = ErgoState.newBoxes(genesis.transactions).find(_.ergoTree == TrueTree).get
+      val otherBox = wusAfterGenesis.versionedBoxHolder.boxes.values.toSeq
+        .filter(b => !java.util.Arrays.equals(b.id, box.id) && wusAfterGenesis.boxById(b.id).isDefined)
+        .sortBy(b => if (b.ergoTree == TrueTree) 0 else 1)
+        .head
+      val nextBlock = validFullBlock(Some(genesis), wusAfterGenesis, Seq(validTransactionFromBoxes(IndexedSeq(otherBox))))
+      nextBlock.transactions.flatMap(_.inputs).exists(i => java.util.Arrays.equals(i.boxId, box.id)) shouldBe false
+      val tx = validTransactionFromBoxes(IndexedSeq(box))
+      nodeViewHolderRef ! LocallyGeneratedTransaction(UnconfirmedTransaction(tx, None))
+      expectMsgType[Accepted]
+      getPoolSize shouldBe 1
+
+      // an input block on genesis selects tx: it leaves the mempool
+      // any header on genesis other than nextBlock's serves as the input block header
+      val ibHeader = nextBlock.header.copy(timestamp = nextBlock.header.timestamp + 1)
+      val ib = InputBlockAnnouncement(1, ibHeader, emptyInputBlockFields, None)
+      ib.header.parentId shouldBe genesis.id
+      val dummyPeer = ConnectedPeer(
+        scorex.core.network.ConnectionId(
+          new java.net.InetSocketAddress("127.0.0.1", 1234),
+          new java.net.InetSocketAddress("127.0.0.1", 5678),
+          scorex.core.network.Outgoing
+        ),
+        testProbe.ref,
+        None
+      )
+      nodeViewHolderRef ! ProcessInputBlock(ib, dummyPeer)
+      nodeViewHolderRef ! ProcessInputBlockTransactions(InputBlockTransactionsData(ib.id, Seq(tx)))
+      Thread.sleep(500)
+      getHistory.getCollectedInputBlocksTransactions(genesis.id).map(_.map(_.id)) shouldBe Some(Seq(tx.id))
+      getPoolSize shouldBe 0
+
+      // nextBlock (not collecting tx) becomes the best full block
+      applyBlock(nextBlock) shouldBe 'success
+      getBestFullBlockOpt.map(_.id) shouldBe Some(nextBlock.id)
+
+      // D2: the reset ran, the parent's set is pruned; D3: tx is back in the mempool
+      getHistory.getCollectedInputBlocksTransactions(genesis.id) shouldBe None
+      getCurrentView.pool.contains(tx.id) shouldBe true
+    }
+  }
