           log.info(s"Processing ${invData.ids.length} non-tx invs (of type $modifierTypeId) from $peer")
           invData.ids.filter(mid => deliveryTracker.status(mid, modifierTypeId, Seq(hr)) == ModifiersStatus.Unknown)
