diff --git a/src/it/scala/org/ergoplatform/it/PartitionHealSpec.scala b/src/it/scala/org/ergoplatform/it/PartitionHealSpec.scala
new file mode 100644
index 000000000..d43ee528e
--- /dev/null
+++ b/src/it/scala/org/ergoplatform/it/PartitionHealSpec.scala
@@ -0,0 +1,113 @@
+package org.ergoplatform.it
+
+import com.typesafe.config.Config
+import org.ergoplatform.it.container.Docker.ExtraConfig
+import org.ergoplatform.it.container.{IntegrationSuite, Node}
+import org.ergoplatform.it.util.ConvergenceWatch
+import org.scalatest.flatspec.AnyFlatSpec
+
+import scala.concurrent.duration._
+import scala.concurrent.{Await, Future}
+
+/**
+  * Partition and heal through the link sidecar ([[container.LinkControl]]): a follower whose only peer is a
+  * miner is cut off with 100% packet loss in both directions, must stop advancing while the miner keeps
+  * mining, and must catch up on the miner's chain once the link is restored.
+  *
+  * The cut is soft: both containers keep running and their TCP sockets stay, which is what a network fault
+  * looks like to the node (a stopped container or a docker-network disconnect closes the socket instead).
+  * That is the condition the existing suite cannot stage.
+  *
+  * The pass is reported only if the miner actually advanced during the cut (`minMinerGain`); otherwise the
+  * test is CANCELED as not exercised, or FAILS under `CI` (env), like [[BestChainConsistencyUnderDelaySpec]].
+  * A follower that advances behind a 100%-loss link fails as `PARTITION_LEAKED`: either the cut was not
+  * applied to every path, or the node found another way to the miner, and both are worth knowing.
+  */
+class PartitionHealSpec extends AnyFlatSpec with IntegrationSuite {
+
+  protected def minerPolling: Int = 2000
+  protected def syncTarget: Int = 3
+  protected def partitionWindow: FiniteDuration = 30.seconds
+  /** Time for the cut to take effect and in-flight blocks to land before the frozen baseline is sampled. */
+  protected def settle: FiniteDuration = 8.seconds
+  protected def minMinerGain: Int = 2
+  protected def healTimeout: FiniteDuration = 3.minutes
+  protected def startupTimeout: FiniteDuration = 3.minutes
+  /** Under CI a cancel is a fail: a green skip would hide the test. */
+  protected def strict: Boolean = sys.env.contains("CI")
+
+  private val meshConfig: ExtraConfig = (docker, _) => Some(knownPeersConfig(docker.nodes.map(_.nodeInfo)))
+
+  protected def minerConfig: Config = internalMinerPollingIntervalConfig(minerPolling).withFallback(nodeSeedConfigs.head)
+  protected def followerConfig: Config = nonGeneratingPeerConfig.withFallback(nodeSeedConfigs(1))
+
+  private def giveUp(reason: String): Nothing =
+    if (strict) fail(s"$reason (CI: a cancel would hide the test)") else cancel(reason)
+
+  it should "freeze a follower behind a 100%-loss link and let it catch up after heal" in {
+    val nodes: List[Node] = List(minerConfig, followerConfig)
+      .map(_.withFallback(allowLocalConfig))
+      .map(cfg => docker.startDevNetNode(cfg, meshConfig).get)
+    val List(miner, follower) = nodes
+    val watch = new ConvergenceWatch(docker, nodes)
+
+    def heightOf(round: Seq[org.ergoplatform.it.util.NodeSample], node: Node): Int =
+      round.find(_.name == node.nodeName).flatMap(_.fullHeight).getOrElse(-1)
+
+    try {
+      // floor: the follower syncs from its only peer
+      val synced = Await.result(
+        watch.until(startupTimeout.fromNow)(r => r.forall(_.answered) && heightOf(r, follower) >= syncTarget)(
+          s"Follower did not reach height $syncTarget from the miner"), startupTimeout + 10.seconds)
+      log.info(s"Synced: follower ${heightOf(synced, follower)}, miner ${heightOf(synced, miner)}")
+
+      // cut: 100% loss both ways, applied from a helper container in each node's namespace. Applying it takes a
+      // few seconds (two helper containers), and blocks already in flight land after it; so the frozen baseline
+      // is sampled AFTER the cut has settled, not before it.
+      docker.partition(miner, follower).left.foreach { error =>
+        giveUp(s"NETEM_UNAVAILABLE: cannot cut the link ${miner.nodeName} <-> ${follower.nodeName} " +
+          s"(host needs sch_netem, sch_prio, cls_u32: `sudo modprobe sch_netem sch_prio cls_u32`). tc said: $error")
+      }
+      Thread.sleep(settle.toMillis)
+      val baseline = Await.result(watch.sample(), 15.seconds)
+      val frozenAt = heightOf(baseline, follower)
+      val minerAt = heightOf(baseline, miner)
+      log.info(s"Cut applied and settled ${settle.toSeconds} s: follower $frozenAt, miner $minerAt; window ${partitionWindow.toSeconds} s")
+      Thread.sleep(partitionWindow.toMillis)
+      val after = Await.result(watch.sample(), 15.seconds)
+      val followerAfter = heightOf(after, follower)
+      val minerAfter = heightOf(after, miner)
+      log.info(s"Partition ${partitionWindow.toSeconds} s: follower $frozenAt -> $followerAfter, miner $minerAt -> $minerAfter")
+
+      if (minerAfter - minerAt < minMinerGain) {
+        giveUp(s"RACE_NOT_EXERCISED: the miner gained only ${minerAfter - minerAt} blocks in ${partitionWindow.toSeconds} s, " +
+          s"so a frozen follower proves nothing")
+      }
+      if (followerAfter != frozenAt) {
+        fail(watch.report(s"PARTITION_LEAKED: the follower advanced $frozenAt -> $followerAfter behind a 100%-loss link " +
+          s"while the miner went $minerAt -> $minerAfter"))
+      }
+
+      // heal: the follower must reach the miner's height and be on the miner's chain at a height mined during the cut
+      docker.heal(miner, follower).left.foreach(error => fail(s"heal ${miner.nodeName} <-> ${follower.nodeName} failed: $error"))
+      val target = minerAfter
+      Await.result(
+        watch.until(healTimeout.fromNow)(r => heightOf(r, follower) >= target)(
+          s"After heal the follower did not reach the miner's height $target"), healTimeout + 10.seconds)
+      val h = frozenAt + 1
+      val ids = Await.result(Future.traverse(nodes)(_.headerIdsByHeight(h)), 30.seconds).map(_.headOption)
+      if (ids.exists(_.isEmpty) || ids.distinct.size != 1) {
+        fail(watch.report(s"After heal the nodes disagree at height $h (mined during the cut): " +
+          nodes.map(_.nodeName).zip(ids.map(_.map(_.take(8)).getOrElse("-"))).map { case (n, id) => s"$n=$id" }.mkString(", ")))
+      }
+      log.info(s"Heal: follower caught up to $target and agrees with the miner at height $h")
+    } catch {
+      case verdict: org.scalatest.exceptions.TestFailedException => throw verdict
+      case verdict: org.scalatest.exceptions.TestCanceledException => throw verdict
+      case diagnosed: java.util.concurrent.TimeoutException if diagnosed.getMessage.contains("CAUSE ") =>
+        fail(diagnosed.getMessage)
+      case scala.util.control.NonFatal(error) =>
+        fail(watch.report(s"HARNESS_ERROR: ${error.getClass.getName}: ${error.getMessage}"), error)
+    } finally watch.close()
+  }
+}
