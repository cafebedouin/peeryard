From 01b27f172b6335ea6fda1df07864e125a8a3820f Mon Sep 17 00:00:00 2001
From: cafebedouin <cafebedouin@gmail.com>
Date: Wed, 28 Oct 2026 10:43:51 -0500
Subject: [PATCH 1/2] chore: bump ergo-lib-wasm-browser to v0.29.0

v0.28.0 cannot parse ErgoTree v3 scripts, so signing a transaction that
spends a box guarded by one fails with `NonConsumedBytes`, first when
extracting signer addresses from the inputs, then in the prover (#354).
v0.29.0 parses and evaluates them. No call site needs changing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 package.json | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/package.json b/package.json
index 6ca4f815..afc26893 100644
--- a/package.json
+++ b/package.json
@@ -45,7 +45,7 @@
     "cn": "^0.4.0",
     "crypto-js": "^4.2.0",
     "dexie": "^4.4.7",
-    "ergo-lib-wasm-browser": "^0.28.0",
+    "ergo-lib-wasm-browser": "^0.29.0",
     "es-toolkit": "^1.52.0",
     "highlight.js": "^11.12.0",
     "ledger-ergo-js": "^0.2.1",
-- 
2.43.0


