+import { ErgoGraphQLProvider } from "@fleet-sdk/blockchain-providers";
+import { EIP12UnsignedTransaction } from "@fleet-sdk/common";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { addressFromErgoTree } from "@/chains/ergo/addresses";
+import { extractAddressesFromInputs } from "@/chains/ergo/extraction";
+import HdKey from "@/chains/ergo/hdKey";
+import { Prover } from "@/chains/ergo/transaction/prover";
+import fixture from "./fixtures/lithos-deposit.json";
+
+vi.mock("@/database/walletsDbService", () => ({ walletsDbService: {} }));
+
+/**
+ * Mainnet transaction 666028b47beab430f18ebfa87e4d07d1eb3767f52ea32c78e31a384958c49eee, a Lithos
+ * liquidity deposit: input 0 is the pool box, guarded by an ErgoTree v3 script, input 1 is the
+ * depositor's P2PK box. `blockHeaders` is an ergo-graphql response for the inclusion block and the
+ * nine blocks before it.
+ */
+const transaction = fixture.transaction as EIP12UnsignedTransaction;
+
+// any wallet will do: it does not own the depositor's key
+const mnemonic =
+  "fade payment weasel market mixed armed decade shed harbor bind deal mandate pink earth second";
+
+async function buildProver() {
+  vi.stubGlobal("fetch", async () => new Response(JSON.stringify(fixture.blockHeaders)));
+  const headers = await new ErgoGraphQLProvider("https://graphql.test").getHeaders({ take: 10 });
+  const deriver = await HdKey.fromMnemonic(mnemonic);
+
+  return new Prover(deriver).from([deriver.deriveAddress(0)]).setHeaders(headers);
+}
+
+describe("prover with ErgoTree v3 inputs", () => {
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it("extracts signer addresses", () => {
+    const depositor = addressFromErgoTree(transaction.inputs[1].ergoTree);
+    expect(extractAddressesFromInputs(transaction.inputs)).toContain(depositor);
+  });
+
+  it("signs the script input", async () => {
+    const prover = await buildProver();
+
+    expect(await prover.signInputs(transaction, [0])).toEqual([
+      { boxId: transaction.inputs[0].boxId, spendingProof: fixture.proofs[0] }
+    ]);
+  });
+
+  it("only fails for the missing key", async () => {
+    const prover = await buildProver();
+
+    await expect(prover.signTransaction(transaction)).rejects.toThrow(
+      /tx input index 1\): .*not have enough witnesses/
+    );
+  });
+});
